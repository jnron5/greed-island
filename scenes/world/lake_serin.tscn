[node name="Npc_neri" parent="." instance=ExtResource("r26_npc")]
position = Vector2(680, -20)
npc_id = &"neri"
display_name = "Neri"
sprite_frames = ExtResource("r27_neri_frames")
lines = PackedStringArray("Serin's the stillest water on the island. You can hear a fish change its mind.", "Barges used to cross here at night, low in the water. Heading north. They don't cross any more. One of them never got across.")
wander_radius = 30.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(60, -260)
script = ExtResource("r28_readable")
title = "The stone on Stone Point"
lines = PackedStringArray("A lone standing stone at the tip of the point, the water all round it. The carving is the one from the circle: a crown, and a line of figures under it.", "Here the line goes on round the back of the stone. The last figures are no bigger than a thumbnail, and there are more of them than you can count.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-380, 290)
script = ExtResource("r28_readable")
title = "A drowned barge"
lines = PackedStringArray("A flat barge, sunk at its mooring in the shallows. Its hold was lined with straw, and fitted with rings for chains.", "Stencilled on the stern, under the weed: 'D.M.C. - NORTH'.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(760, -30)
script = ExtResource("r28_readable")
title = "Neri's tally board"
lines = PackedStringArray("A board of chalk tallies: fish, by the day. On the back, a different tally, not fish. Barges crossing, by the night. It stops last spring.")

