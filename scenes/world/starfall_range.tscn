[node name="Npc_hald" parent="." instance=ExtResource("r18_npc")]
position = Vector2(540, -80)
npc_id = &"hald"
display_name = "Hald"
sprite_frames = ExtResource("r20_hald_frames")
lines = PackedStringArray("Frisalle's over the pass. Nobody's crossed since the slide. Nobody's tried very hard.", "The slide came down the week after the last barge went north. The Company men were up here with powder the week before. Make of that what you like.")
wander_radius = 30.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(120, -660)
script = ExtResource("r21_readable")
title = "The Starfall stone"
lines = PackedStringArray("The last of the stones, high under the pass. The crown is carved here too, and the line of figures. But on this one the line doesn't stop: it runs down the stone and into the snow.", "Scratched at the bottom, fresh: a crown, crossed out.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-60, -780)
script = ExtResource("r21_readable")
title = "The pass to Frisalle"
lines = PackedStringArray("Snow and boulders to twice your height, packed hard. A sign hammered into the drift: 'PASS CLOSED. Frisalle beyond.'", "Drill holes in the rock above the slide. Somebody brought it down on purpose.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(-200, 380)
script = ExtResource("r21_readable")
title = "Frozen cart tracks"
lines = PackedStringArray("Wagon ruts frozen into the old road, heading north. Deep ones: a heavy load, or a lot of people.")

