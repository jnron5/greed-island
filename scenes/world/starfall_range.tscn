[node name="Npc_hald" parent="." instance=ExtResource("r18_npc")]
position = Vector2(540, -80)
npc_id = &"hald"
display_name = "Hald"
sprite_frames = ExtResource("r20_hald_frames")
lines = PackedStringArray("Frisalle's over the pass. Since the slide they've set a toll gate in it: one wolf collar a head. The wolves took their goats, so they want the wolves' collars. Fair, I suppose.", "The slide came down the week after the last barge went north. The Company men were up here with powder the week before. Make of that what you like.", "There's a cave in the east shoulder, past my woodpile. Ice all the way through. The wolves den in it now. The Company used it before the wolves did.")
wander_radius = 30.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(120, -660)
script = ExtResource("r21_readable")
title = "The Starfall stone"
lines = PackedStringArray("The last of the stones, high under the pass. The crown is carved here too, and the line of figures. But on this one the line doesn't stop: it runs down the stone and into the snow.", "Scratched at the bottom, fresh: a crown, crossed out.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-60, -780)
script = ExtResource("r21_readable")
title = "The pass to Frisalle"
lines = PackedStringArray("Snow and boulders to twice your height, packed hard, dug through in the middle to a stout gate. A sign hammered into the drift: 'FRISALLE. Toll: one Iron Wolf Collar. The wolves took our goats; bring us one of theirs.'", "Drill holes in the rock above the slide. Somebody brought it down on purpose.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(-200, 380)
script = ExtResource("r21_readable")
title = "Frozen cart tracks"
lines = PackedStringArray("Wagon ruts frozen into the old road, heading north. Deep ones: a heavy load, or a lot of people.")

