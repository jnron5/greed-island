[node name="Npc_aldous" parent="." instance=ExtResource("r57_npc")]
position = Vector2(620, -270)
npc_id = &"aldous"
display_name = "Aldous"
sprite_frames = ExtResource("r58_aldous_frames")
lines = PackedStringArray("The stones were here before the kings. Before the towns. Before, I think, the cards.", "I've spent forty years reading what's carved on them. It's the same story on every one, told smaller each time.")
wander_radius = 20.0
has_night_spot = true
night_spot = Vector2(720, -230)
night_wander = 0.0

[node name="Npc_marta" parent="." instance=ExtResource("r57_npc")]
position = Vector2(-560, -20)
npc_id = &"marta"
display_name = "Marta"
sprite_frames = ExtResource("r59_marta_frames")
lines = PackedStringArray("Harvest's in early. Half of it's sold before it's cut, to the Company men from Duskara. Paid in scrip.", "Scrip spends at the Company store and nowhere else. Funny, that.")
wander_radius = 40.0
out_from = 5.0
out_to = 20.0

[node name="Npc_oda" parent="." instance=ExtResource("r57_npc")]
position = Vector2(-300, -16)
npc_id = &"oda"
display_name = "Oda"
sprite_frames = ExtResource("r60_oda_frames")
lines = PackedStringArray("Every thread on that loom is somebody. I weave them in so they don't get lost.", "My grandson went west with the Company carts two harvests ago. They said Lake Serin way, then north. I've not been further than the mill in twenty years.")
wander_radius = 30.0
out_from = 6.5
out_to = 20.5

[node name="Npc_pim" parent="." instance=ExtResource("r57_npc")]
position = Vector2(340, -20)
npc_id = &"pim"
display_name = "Pim"
sprite_frames = ExtResource("r61_pim_frames")
lines = PackedStringArray("Fresh this morning! Well. This morning-ish. The oven's been going since before the larks.", "The Company used to take a cartload of hard bread every week for the dune road. Stopped three weeks ago. Nobody's said why. I keep baking it anyway.")
wander_radius = 20.0
shop_stock = Array[StringName]([&"bread", &"smoked_fish"])
shop_buys_cards = false
shop_title = "Pim's Bakery"
out_from = 4.5
out_to = 18.5

[node name="Npc_bruno" parent="." instance=ExtResource("r57_npc")]
position = Vector2(60, -20)
npc_id = &"bruno"
display_name = "Bruno"
sprite_frames = ExtResource("r62_bruno_frames")
lines = PackedStringArray("I cook for the Sheaf and Sickle. Tally runs it, inside: beds, cider, and the tally of who owes what. I just feed people.", "The last racer through here paid in cards. I don't want cards. I want a quiet life and a full cellar.")
wander_radius = 20.0
shop_stock = Array[StringName]([&"bread", &"smoked_fish", &"healers_tonic"])
shop_buys_cards = false
shop_title = "Bruno's Kitchen"
out_from = 6.0
out_to = 20.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(-180, 54)
script = ExtResource("r63_readable")
title = "The harvest board"
lines = PackedStringArray("WANTED: HANDS FOR THE DUSKARA WORKS. Small hands preferred for close work. Room, board and a trade. Apply to the Company agent, first of the month.", "Somebody has written underneath, in pencil: 'none of ours'. Somebody else has crossed it out.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-640, 196)
script = ExtResource("r63_readable")
title = "A snag of red wool"
lines = PackedStringArray("Caught on a reed stem at the water's edge: a long tail of knitted wool, red as madder, unravelling in the current.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(130, 214)
script = ExtResource("r63_readable")
title = "A scrap of paper in the reeds"
lines = PackedStringArray("A soaked chit, the ink run but readable: 'D.M.C. North depot. Pay to bearer: one ration.' On the back, in a child's hand, a name scratched out.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(660, 220)
script = ExtResource("r63_readable")
title = "A little carved bird"
lines = PackedStringArray("Wedged between two stones where the stream bends: a small wooden bird, carved the way they carve them in Sorenda, worn smooth by the water.")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(446, 500)
script = ExtResource("r63_readable")
title = "The mill ledger"
lines = PackedStringArray("A ledger nailed up by the mill door. 'Flour to D.M.C.: 200 sacks. Rate: one third market, by agreement.'", "'By agreement' is underlined twice, hard enough to tear the page.")

[node name="Read5" type="Node2D" parent="."]
position = Vector2(680, -300)
script = ExtResource("r63_readable")
title = "A stone by the scholar's door"
lines = PackedStringArray("A fragment of a standing stone, set upright by the door. The same carving as the circle on the downs: a crown, and under it a line of figures, each one smaller.")

