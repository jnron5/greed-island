[node name="Npc_freya" parent="." instance=ExtResource("r54_npc")]
position = Vector2(60, -330)
npc_id = &"freya"
display_name = "Freya"
sprite_frames = ExtResource("r55_freya_frames")
lines = PackedStringArray("You've come a long way, racer. Everyone does, in the end. Vetrassa's where the roads stop.", "Captain of the King's Guard. Which mostly means guarding an empty chair. My father hasn't sat in it in months. He travels.", "My brother cooks. My other brother hides. My mother counts. I stand on these steps with a sword and wait for someone to bring the whole set up them.", "The Steward will see you in the throne room if you hold all of it. Not before. He's very particular about 'all'.", "There's a ledger in the throne room nobody's allowed to read but the King. I've read it. Don't ask me what's in it. Not yet.")
wander_radius = 30.0

[node name="Npc_guard0" parent="." instance=ExtResource("r54_npc")]
position = Vector2(-64, -160)
npc_id = &"kings_guard"
display_name = "King's Guard"
sprite_frames = ExtResource("r56_kings_guard_fram")
lines = PackedStringArray("The palace terrace is open to racers. Mind the steps; they've been worn by a lot of hopeful feet.")
wander_radius = 0.0

[node name="Npc_guard1" parent="." instance=ExtResource("r54_npc")]
position = Vector2(64, -160)
npc_id = &"kings_guard"
display_name = "King's Guard"
sprite_frames = ExtResource("r56_kings_guard_fram")
lines = PackedStringArray("Only one of you ever goes up those steps with a full binder. The rest come back down.")
wander_radius = 0.0

[node name="Npc_guard2" parent="." instance=ExtResource("r54_npc")]
position = Vector2(-70, -390)
npc_id = &"kings_guard"
display_name = "King's Guard"
sprite_frames = ExtResource("r56_kings_guard_fram")
lines = PackedStringArray("The throne room. The Steward's inside.")
wander_radius = 0.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(50, 100)
script = ExtResource("r57_readable")
title = "The Crown Square fountain"
lines = PackedStringArray("The same fountain as Kalmora's, stone for stone: the two ports were built by the same first king, at the two ends of his island.", "Round the rim, in old letters: 'WHAT IS GATHERED AT ONE END IS CROWNED AT THE OTHER.'")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-200, 200)
script = ExtResource("r57_readable")
title = "The race board"
lines = PackedStringArray("A board by the fountain, freshly painted: 'THE RACE. Present the complete set to the Steward of the Set in the throne room. The first to do so is owed what was promised.'", "What was promised isn't written anywhere. Underneath, someone has chalked: 'riches beyond your wildest dreams'. Someone else has chalked: 'ask what they cost'.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(330, -90)
script = ExtResource("r57_readable")
title = "A crest over a door"
lines = PackedStringArray("A coat of arms carved over the door of the grandest townhouse on the square: a dachshund's head over a crossed pick. The Duke's. The same mark as the seal on the Frisalle letters.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(500, 420)
script = ExtResource("r57_readable")
title = "The customs house ledger"
lines = PackedStringArray("A ledger chained to a lectern by the cargo doors. 'Arrivals: cards, uncut, from D.M.C. (north road, by the shoulder). Duty: waived, by order.' By whose order isn't written.")

