[node name="Npc_ferro" parent="." instance=ExtResource("r38_npc")]
position = Vector2(-60, 160)
npc_id = &"ferro"
display_name = "Ferro"
sprite_frames = ExtResource("r39_ferro_frames")
lines = PackedStringArray("Rough sea today. It's always rough. Halmeer's the end of the coast; the sea takes it personally.", "The Company buys our catch for salt-fish. Never seen them salt a single fish. Never seen them eat one either.", "Old Nessa up on the cape keeps the light. Most nights. Ask her about the other nights, if you're brave.", "On a still night you can hear oars under the cape. Seals, the Company man says. Seals don't row.", "Nobody comes to Halmeer unless they're lost, a racer, or the Company. You're not lost, are you?")
wander_radius = 50.0

[node name="Npc_grisel" parent="." instance=ExtResource("r38_npc")]
position = Vector2(255, 226)
npc_id = &"grisel"
display_name = "Grisel"
sprite_frames = ExtResource("r40_grisel_frames")
lines = PackedStringArray("Duskara Mining Company, Halmeer office. Salt and fish. Mostly salt. Please don't lean on the crates.", "I'm not permitted to discuss the salt house's contents. Salt. The contents are salt.", "Vetrassa had theatres. Halmeer has gulls. I have been very patient with the gulls.")
wander_radius = 0.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(-80, 140)
script = ExtResource("r41_readable")
title = "The tide board"
lines = PackedStringArray("A slate board on the quay with the month's tides chalked in neat columns. Beside some nights, a little mark: a pick. The same nights, every month: no moon.", "Underneath, in a different hand: 'LIGHT DARK. By order. D.M.C.'")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(160, 224)
script = ExtResource("r41_readable")
title = "The salt house door"
lines = PackedStringArray("The Company's warehouse: 'D.M.C. SALT AND FISH'. The doors are barred and padlocked, and the padlock is new. There's no smell of fish at all.", "Through a gap in the boards, crates stamped like the ones on Kalmora's quay. On one the lid's been prised up: no salt. Cards, uncut, packed in straw.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(620, 200)
script = ExtResource("r41_readable")
title = "A memorial on the cliff"
lines = PackedStringArray("A stone on the cliff edge with the names of Halmeer's drowned, a century of them. The newest line is cut shallow, in a hurry: 'and the ones who rowed out on the dark nights'.")

