display_name = "Pip"
sprite_frames = ExtResource("n_pip")
lines = PackedStringArray("Fresh fish! Well. Fresh-ish.", "My cousin went to work out in Duskara last spring. Good pay, they said. He hasn't written.")
wander_radius = 12.0
out_from = 6.0
out_to = 2.0
night_lines = PackedStringArray("Grilled fish on a stick! Fresh-ish! Half price after midnight because I want to dance!", "My cousin used to dance on the fountain rim. Before Duskara. He was the best of us.")
chatter = PackedStringArray("Fish on a stick!", "Half price!", "~ la la la ~")
has_night_spot = true
night_spot = Vector2(662, 174)
night_wander = 10.0

[node name="Npc_sailor" parent="." instance=ExtResource("19_npc")]
position = Vector2(4, 300)
npc_id = &"sailor"
display_name = "Deckhand Luca"
sprite_frames = ExtResource("n_sailor")
lines = PackedStringArray("Sailed round the whole isle once. Vetrassa's got the tallest spires you ever saw.", "You racers bind your cards in town, right? Thieves love a loose card on the road.")
wander_radius = 40.0
patrol = PackedVector2Array(0, 0, -266, -28, -168, 0, -84, -14, 0, 0, 28, 70, 0, 0)
out_from = 6.5
out_to = 2.0
night_lines = PackedStringArray("Dance with me, racer! No? Coward. Come back when you've had a cider.", "Lantern Night, every night! The only port on the island that knows how to end a day.")
chatter = PackedStringArray("~ Oh the gull, the gull ~", "Who's dancing?", "Faster, faster!")
has_night_spot = true
night_spot = Vector2(718, 174)
night_wander = 24.0

[node name="Npc_baker" parent="." instance=ExtResource("19_npc")]
position = Vector2(376, 196)
npc_id = &"baker"
display_name = "Baker Rosa"
sprite_frames = ExtResource("n_baker")
lines = PackedStringArray("Warm bread! Two coins a loaf, one if you tell me a good rumor.", "The Runner came through at dawn, all scarf and no manners. Didn't even stop for bread.")
wander_radius = 0.0
patrol = PackedVector2Array(0, 0, 0, -59, -98, -59, -210, -64, -98, -59, 0, -59, 0, 0)
out_from = 5.0
out_to = 2.0
night_lines = PackedStringArray("Honey buns, still warm. The dough rises while we dance. Bakers' secret.", "Rosa's rule: nobody goes home hungry and nobody goes home before the song about the gull.")
chatter = PackedStringArray("Honey buns!", "Mind the crumbs!", "Who wants the last one?")
has_night_spot = true
night_spot = Vector2(284, 112)
night_wander = 8.0

[node name="Npc_tomas" parent="." instance=ExtResource("19_npc")]
position = Vector2(620, 230)
npc_id = &"tomas"
display_name = "Keeper Tomas"
sprite_frames = ExtResource("n_tomas")
lines = PackedStringArray("Lent my spare wick to Ilse the mapmaker and never got it back. Good thing I keep three.", "That lens up there's worth more than my whole cottage. Door stays locked, wick or no wick.")
wander_radius = 0.0
out_from = 6.0
out_to = 19.5

[node name="Npc_rook" parent="." instance=ExtResource("19_npc")]
position = Vector2(43, -607)
npc_id = &"rook"
display_name = "Guard Rook"
sprite_frames = ExtResource("n_rook")
lines = PackedStringArray("North road's sealed. A Salt Compass opens it. Old rule, nobody remembers why.", "Thornveil's no place to wander with loose cards. The hounds don't care, but the Raider does.")
wander_radius = 0.0
night_lines = PackedStringArray("Going out the north road? At this hour? The forest's savage after dark. Red-eyed hounds, twice as tough.", "Night watch. The town parties, I stand here. Somebody has to keep what's out there, out there.")
has_night_spot = true
night_spot = Vector2(4, -585)
night_wander = 20.0

[node name="Npc_nonna" parent="." instance=ExtResource("19_npc")]
position = Vector2(-46, -142)
npc_id = &"nonna"
display_name = "Nonna Vess"
sprite_frames = ExtResource("n_nonna")
lines = PackedStringArray("I've danced in this square every night for sixty years. Tonight I'm sitting. Tomorrow, who knows.")
wander_radius = 0.0
out_from = 20.0
out_to = 23.0
chatter = PackedStringArray("In my day we danced till dawn!", "Lovely lanterns.", "Mind your feet, dear.")

[node name="Npc_wen" parent="." instance=ExtResource("19_npc")]
position = Vector2(754, 84)
npc_id = &"wen"
display_name = "Wen"
sprite_frames = ExtResource("n_wen")
lines = PackedStringArray("Mama says I can stay up till the lanterns go blue. They never go blue. I checked.")
wander_radius = 22.0
out_from = 20.0
out_to = 22.5
chatter = PackedStringArray("I'm not tired!", "Look, a shooting star!", "~ the gull, the gull ~")

[node name="Npc_ilse" parent="." instance=ExtResource("19_npc")]
position = Vector2(172, -112)
npc_id = &"ilse"
display_name = "Ilse"
sprite_frames = ExtResource("n_ilse")
lines = PackedStringArray("I map the island by day and the gossip by night. The gossip's more accurate.")
wander_radius = 10.0
out_from = 20.0
out_to = 2.0
chatter = PackedStringArray("Did you hear about the Duke?", "Don't tell anyone I said so.", "Another cider?")

[node name="Npc_brannoc" parent="." instance=ExtResource("19_npc")]
position = Vector2(259, -112)
npc_id = &"brannoc"
display_name = "Brannoc"
sprite_frames = ExtResource("n_brannoc")
lines = PackedStringArray("Coals are banked, anvil's cold. One cider. Then another one. Then home.")
wander_radius = 8.0
out_from = 20.0
out_to = 2.0
chatter = PackedStringArray("To cold anvils!", "One more. Just one.", "Ha!")

