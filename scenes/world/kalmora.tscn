[node name="Npc_bram" parent="." instance=ExtResource("19_npc")]
position = Vector2(-192, 244)
npc_id = &"bram"
display_name = "Bram"
sprite_frames = ExtResource("n_bram")
lines = PackedStringArray("Tide's good today. Good for ships, anyway.")
wander_radius = 0.0

[node name="Npc_mirela" parent="." instance=ExtResource("19_npc")]
position = Vector2(-402, 261)
npc_id = &"mirela"
display_name = "Harbormaster Mirela"
sprite_frames = ExtResource("n_mirela")
lines = PackedStringArray("Manifests, manifests. Everything that lands in Kalmora gets a stamp. Everything.", "The race? The whole island's talking. Somebody's walking into Vetrassa with a full set, mark my words.")
wander_radius = 0.0

[node name="Npc_pip" parent="." instance=ExtResource("19_npc")]
position = Vector2(144, 160)
npc_id = &"pip"
display_name = "Pip"
sprite_frames = ExtResource("n_pip")
lines = PackedStringArray("Fresh fish! Well. Fresh-ish.", "My cousin went to work out in Duskara last spring. Good pay, they said. He hasn't written.")
wander_radius = 30.0

[node name="Npc_sailor" parent="." instance=ExtResource("19_npc")]
position = Vector2(4, 300)
npc_id = &"sailor"
display_name = "Deckhand Luca"
sprite_frames = ExtResource("n_sailor")
lines = PackedStringArray("Sailed round the whole isle once. Vetrassa's got the tallest spires you ever saw.", "You racers bind your cards in town, right? Thieves love a loose card on the road.")
wander_radius = 40.0

[node name="Npc_baker" parent="." instance=ExtResource("19_npc")]
position = Vector2(-192, -148)
npc_id = &"baker"
display_name = "Baker Rosa"
sprite_frames = ExtResource("n_baker")
lines = PackedStringArray("Warm bread! Two coins a loaf, one if you tell me a good rumor.", "The Runner came through at dawn, all scarf and no manners. Didn't even stop for bread.")
wander_radius = 30.0

[node name="Npc_tomas" parent="." instance=ExtResource("19_npc")]
position = Vector2(620, 230)
npc_id = &"tomas"
display_name = "Keeper Tomas"
sprite_frames = ExtResource("n_tomas")
lines = PackedStringArray("Lost my lighthouse wick somewhere up on the hill houses. Can't light the lamp without it.", "That lens up there's worth more than my whole cottage. Door stays locked, wick or no wick.")
wander_radius = 0.0

[node name="Npc_rook" parent="." instance=ExtResource("19_npc")]
position = Vector2(43, -607)
npc_id = &"rook"
display_name = "Guard Rook"
sprite_frames = ExtResource("n_rook")
lines = PackedStringArray("North road's sealed. A Salt Compass opens it. Old rule, nobody remembers why.", "Thornveil's no place to wander with loose cards. The hounds don't care, but the Raider does.")
wander_radius = 0.0

