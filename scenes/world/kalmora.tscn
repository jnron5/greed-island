[node name="Npc_bram" parent="." instance=ExtResource("19_npc")]
position = Vector2(-192, 244)
npc_id = &"bram"
display_name = "Bram"
sprite_frames = ExtResource("n_bram")
lines = PackedStringArray("Tide's good today. Good for ships, anyway.")
wander_radius = 0.0
out_from = 6.5
out_to = 2.0
night_lines = PackedStringArray("No crates tonight. Tonight the crates can carry themselves. Another round!", "Night tide's coming in. Don't look at the pier. Look at the lanterns. Lanterns are nice.")
chatter = PackedStringArray("To Kalmora!", "Another round!", "Otto! The good cider!")
has_night_spot = true
night_spot = Vector2(-234, 266)
night_wander = 16.0

[node name="Npc_mirela" parent="." instance=ExtResource("19_npc")]
position = Vector2(-402, 261)
npc_id = &"mirela"
display_name = "Harbormaster Mirela"
sprite_frames = ExtResource("n_mirela")
lines = PackedStringArray("Manifests, manifests. Everything that lands in Kalmora gets a stamp. Everything.", "The race? The whole island's talking. Somebody's walking into Vetrassa with a full set, mark my words.")
wander_radius = 0.0
night_lines = PackedStringArray("Somebody has to keep one eye on the quay. I keep the other one on the cider.", "Party all you like. Anything that lands tonight still gets a stamp. Tomorrow.")
chatter = PackedStringArray("Not on the fountain, Luca.", "Hmph.", "One more song, then bed.")
has_night_spot = true
night_spot = Vector2(-346, 275)
night_wander = 10.0

