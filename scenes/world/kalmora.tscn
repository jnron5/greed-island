[node name="Read1" type="Node2D" parent="."]
position = Vector2(-878, -215)
script = ExtResource("30_read")
title = "The west road signpost"
lines = PackedStringArray("An arm points west: 'AUREWIND PLAINS - VERDANA - LAKE SERIN'. Under it, carved smaller: 'Gate opens to the Warden's crest.'", "Someone has added in chalk: 'good luck with THAT'.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(-102, -89)
script = ExtResource("30_read")
title = "The notice board"
lines = PackedStringArray("ROYAL PROCLAMATION. The Race of Cards is open to all who reach Kalmora by sea. The first to present the full set at Vetrassa shall receive riches beyond measure, by the King's own hand.", "Pinned beneath it, newer: 'WORKERS WANTED - DUSKARA. Good pay, in cards. Small hands preferred. Enquire at the harbor.'")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(-198, -151)
script = ExtResource("30_read")
title = "Greta's Provisions"
lines = PackedStringArray("A painted board by the door: a loaf, a fish and a green bottle.", "'GRETA'S PROVISIONS - Bread, smoked fish, tonics & elixirs for the road. Racers welcome. Bleeding racers especially welcome.'")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(-13, -19)
script = ExtResource("30_read")
title = "The fountain's plaque"
lines = PackedStringArray("'Gift of the Calloway family to the people of Kalmora, in the year of the Sixth Race. Drink freely.'")

[node name="Read5" type="Node2D" parent="."]
position = Vector2(670, 345)
script = ExtResource("30_read")
title = "The keeper's log"
lines = PackedStringArray("Nailed by the lighthouse door: 'Lamp lit 212 nights this year. The southern barges run dark. I am told not to log them. I log them anyway. - Tomas'")

[node name="Read6" type="Node2D" parent="."]
position = Vector2(242, 373)
script = ExtResource("30_read")
title = "A barred archway"
lines = PackedStringArray("An old archway in the harbor wall, barred shut. Cold air breathes out through the bars, and with it, faintly, the smell of sand.")

