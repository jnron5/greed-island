[node name="Npc_rafi" parent="." instance=ExtResource("r50_npc")]
position = Vector2(-30, 170)
npc_id = &"rafi"
display_name = "Rafi"
sprite_frames = ExtResource("r51_rafi_frames")
lines = PackedStringArray("Water! Sweet water from the Sunwell, not the Company tank! A copper a cup, and you don't have to sign anything for it.", "The Company sells water too. Cheaper. You pay in scrip, and the scrip comes out of your wages, and the wages come out of the mine. I sell it for copper.", "Duskara has two kinds of people: those who go down the shaft, and those who count them coming up. I sell water to both. I'd rather sell to the first.", "Zahra says the bell still rings? ...Good. That's good. Thank you, friend. Don't say it again where the foreman can hear.", "The cistern under the square is older than the Company, older than the King. The Company built a tank and a meter. The cistern doesn't charge.")
wander_radius = 40.0
shop_stock = Array[StringName]([&"bread", &"healers_tonic"])
shop_buys_cards = false
shop_title = "Rafi's Water & Bread"
out_from = 6.0
out_to = 21.0

[node name="Npc_nib" parent="." instance=ExtResource("r50_npc")]
position = Vector2(100, 190)
npc_id = &"nib"
display_name = "Nib"
sprite_frames = ExtResource("r52_nib_frames")
lines = PackedStringArray("Message for the office? I run 'em. Fastest legs in Duskara. Fastest legs above ground, anyway.", "I used to work down the shaft. Then my legs got too long for the low seams, so they made me a runner. Lucky.", "Don't look at my wrist. It's just a mark. Everybody's got one. Well. Everybody who came from down there.", "The foreman's fair. That's what everybody says. She's fair. She counts us every night, fair and square.", "If you see a light under the dunes at night, it isn't ghosts. Don't tell anyone I said that.")
wander_radius = 80.0
out_from = 6.0
out_to = 20.0

[node name="Npc_xena" parent="." instance=ExtResource("r50_npc")]
position = Vector2(80, -420)
npc_id = &"xena"
display_name = "Xena"
sprite_frames = ExtResource("r53_xena_frames")
lines = PackedStringArray("You're on Company ground. Say what you want or go back down the stairs.", "I'm the foreman. I keep the shaft working and the count true. Every name in, every name out. That's the job.", "People think a mine is cruelty. A mine is bread. Without the shaft, this town is sand. I keep them working because working keeps them fed.", "Racers. You'll spend more cards in a week than my diggers bring up in a season, and you'll never once ask where they came from.", "My husband likes to travel. My son likes to hide. Somebody in this family has to stay and keep the books.", "The lower gate is closed to visitors. That isn't a request.")
wander_radius = 30.0

[node name="Npc_vash" parent="." instance=ExtResource("r50_npc")]
position = Vector2(290, 268)
npc_id = &"vash"
display_name = "Vash"
sprite_frames = ExtResource("r54_vash_frames")
lines = PackedStringArray("Spells! Spells for the bold and the sticky-fingered! Step up, step up, and keep one hand on your purse. Not because of me. Probably.", "A Mirage Veil, my friend, and the rivals on your heels will see nothing but heat on the sand. Twenty seconds of being nobody. Priceless. Sixty gold.", "Dust Devils come in from the dunes in the afternoon. I catch them in the cards. Cast one in a crowd and watch everybody close by rub their eyes.", "The Company buys my Lockbox Seals by the crate. What a mining company needs with that many locks, I couldn't tell you. I could. I won't.")
wander_radius = 0.0
shop_stock = Array[StringName]([&"pickpockets_whisper", &"lockbox_seal", &"mirage_veil", &"dust_devil"])
shop_buys_cards = false
shop_title = "Vash's Spellcards"
out_from = 7.0
out_to = 23.0

[node name="Npc_hana" parent="." instance=ExtResource("r50_npc")]
position = Vector2(374, 268)
npc_id = &"hana"
display_name = "Hana"
sprite_frames = ExtResource("r55_hana_frames")
lines = PackedStringArray("Brews! Fresh this morning! Well, this week. Brews don't go off, they just get more interesting.", "Scarab Fury puts fire in your sword arm for half a minute. Glass Skin makes you hard as a bottle for a few breaths. Swiftsand makes you fast. Don't mix them. Or do, and tell me what happens.", "My best customer is a courier who drinks a Swiftsand every morning to beat the carts to Duskara. He's very fast. He's also never once sat down.", "Oren lends me his sand for the Glass Skin. Rafi lends me his water. I lend everyone my opinions. It's a good market.")
wander_radius = 0.0
shop_stock = Array[StringName]([&"second_wind", &"scarab_fury", &"glass_skin", &"swiftsand_draught", &"healers_tonic"])
shop_buys_cards = false
shop_title = "Hana's Brews"
out_from = 7.0
out_to = 22.0

[node name="Npc_ammar" parent="." instance=ExtResource("r50_npc")]
position = Vector2(458, 268)
npc_id = &"ammar"
display_name = "Ammar"
sprite_frames = ExtResource("r56_ammar_frames")
lines = PackedStringArray("Sit, child, sit. A charm isn't bought, it's chosen. Well. It's chosen, then it's bought. I'm old, not foolish.", "The Scarab Ward. The scarab rolls the sun across the sky every morning. It can roll a claw aside, if it likes you. One in four times, it likes you.", "My grandfather was a prospector, before the Company. He wore a little brass pick on a coin and found gold in the dry wadis. Then the Company bought the wadis. Now I make the charms and he's in the ground.", "Wear two charms at most. More than that and they argue among themselves, and you'll lose the argument.")
wander_radius = 0.0
shop_stock = Array[StringName]([&"hollowpoint_charm", &"tidewalker_anklet", &"scarab_ward", &"prospectors_charm"])
shop_buys_cards = false
shop_title = "Ammar's Charms"
out_from = 8.0
out_to = 21.0

[node name="Npc_tamsa" parent="." instance=ExtResource("r50_npc")]
position = Vector2(542, 268)
npc_id = &"tamsa"
display_name = "Tamsa"
sprite_frames = ExtResource("r57_tamsa_frames")
lines = PackedStringArray("Way-cards for every town on Virelia! Every one I've been to, anyway, and I've been to all of them that'll have me.", "Kalmora, Sorenda, Verdana, Seabright, Frisalle, here. A return to any of them, at the same price the towns charge. Saves you the walk back.", "There's Halmeer on the south cape and Vetrassa in the north-west, of course, but nobody sells a way to Vetrassa. You have to earn that road.", "I've walked every road on this island twice. The roads to Duskara are the only ones with more carts coming back than going.")
wander_radius = 0.0
shop_stock = Array[StringName]([&"kalmora_return", &"sorenda_return", &"verdana_return", &"seabright_return", &"frisalle_return", &"duskara_return"])
shop_buys_cards = false
shop_title = "Tamsa's Way-Cards"
out_from = 7.0
out_to = 22.0

[node name="Npc_isra" parent="." instance=ExtResource("r50_npc")]
position = Vector2(626, 268)
npc_id = &"isra"
display_name = "Isra"
sprite_frames = ExtResource("r58_isra_frames")
lines = PackedStringArray("Rarities. Set cards, the real thing, the kind racers bleed for. Four a day, never the same four. I don't haggle and I don't explain.", "Where do they come from? Out of the ground, darling. Where else does anything come from?", "The Company counts every card that comes up the North Shaft. Nearly every card. The ones it doesn't count come to me, and then to you.", "I'll buy too. I pay fair. Fairer than the merchants in the towns. They only resell to the Company anyway; I cut out the middle.", "A racer's family from Vetrassa buys from me by the crate. Old money, older debts. Discreet people. I like discreet people.")
wander_radius = 0.0
shop_stock = Array[StringName]([&"lockbox_seal"])
shop_buys_cards = true
shop_title = "Isra's Rarities"
shop_daily_cards = 4
out_from = 9.0
out_to = 23.5

[node name="Npc_company_man0" parent="." instance=ExtResource("r50_npc")]
position = Vector2(-104, -276)
npc_id = &"company_man"
display_name = "Company Man"
sprite_frames = ExtResource("r59_company_man_fram")
lines = PackedStringArray("Terrace is Company ground. Mind your business up there.")
wander_radius = 0.0

[node name="Npc_company_man1" parent="." instance=ExtResource("r50_npc")]
position = Vector2(-8, -276)
npc_id = &"company_man"
display_name = "Company Man"
sprite_frames = ExtResource("r59_company_man_fram")
lines = PackedStringArray("Foreman's busy. She's always busy.")
wander_radius = 0.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(514, 412)
script = ExtResource("r60_readable")
title = "The souk's arch"
lines = PackedStringArray("A sandstone arch hung with bunting made of real cards, faded and cracked: commons nobody wanted, strung up for luck. A painted sign: 'THE CARD SOUK. ALL CARDS. ALL PRICES. NO QUESTIONS.'", "Someone has scratched underneath it, small: 'ask where they come from'.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(60, 170)
script = ExtResource("r60_readable")
title = "The cistern plaque"
lines = PackedStringArray("A bronze plaque on the cistern's rim, green with age: 'THE DEEP WELL OF DUSKARA. Free to all who thirst. By order of the first king.'", "Below it, a newer brass plate bolted over the old words: 'Water rights: Duskara Mining Company. Metered supply at the Company tank.'")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(300, 136)
script = ExtResource("r60_readable")
title = "The Company notice board"
lines = PackedStringArray("'D.M.C. HIRING. Small hands preferred for close work. Room, board and a trade. Apply to the foreman, upper terrace.' The same notice as the one in Verdana.", "Under it, a list headed 'DEBTS DISCHARGED THIS MONTH': two names. A longer list beside it, headed 'DEBTS OUTSTANDING', runs off the bottom of the board.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(250, -480)
script = ExtResource("r60_readable")
title = "The mine shaft gate"
lines = PackedStringArray("A shaft cut into the rim, timbered, with a pulley wheel over it and an iron gate chained across. A sign: 'NORTH SHAFT. COMPANY BUSINESS ONLY. HEADS COUNTED AT THE GATE.'", "Through the bars the air comes up cool and smells of wet stone. Far down, very faintly, someone is singing.")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(-110, -370)
script = ExtResource("r60_readable")
title = "A tally post"
lines = PackedStringArray("A post at the top of the stairs, scored with notches in long rows. Each row is a day. Each notch is somebody going down. A second, shorter row beside it: coming up.")

[node name="Read5" type="Node2D" parent="."]
position = Vector2(-270, -40)
script = ExtResource("r60_readable")
title = "A chalk drawing"
lines = PackedStringArray("Drawn low on a wall in white chalk, at a child's height: a sun, a dune, and a long line of little stick figures walking into a hole in the ground. One of them is walking the other way.")

