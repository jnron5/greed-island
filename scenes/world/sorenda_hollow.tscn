[node name="Read0" type="Node2D" parent="."]
position = Vector2(-480, 240.0)
script = ExtResource("14_read")
title = "Scratches on the wall"
lines = PackedStringArray("Tally marks, scratched low on the rock with a stone. Seven of them. Then the scratches stop being tallies and start being a small, careful drawing of a door.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-64, -144.0)
script = ExtResource("14_read")
title = "A torn sleeve"
lines = PackedStringArray("A strip of rough cloth caught on the rock where the passage narrows. It's stamped, like a sack: 'D.M. - issue'.", "Someone small squeezed through here. Something much bigger has been rubbing the rock smooth trying to follow.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(496.0, -272.0)
script = ExtResource("14_read")
title = "A satchel in the moss"
lines = PackedStringArray("A canvas satchel, stiff with old rain, tucked into the driest corner of the cave. Inside: a heel of bread gone to stone, a little carved wooden bird, and a tin work tag stamped 'D.M. - No. 117'.", "Scratched into the rock above it, low down, where a small hand could reach: 'I ran. Tell mama I ran.'")

