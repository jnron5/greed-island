[node name="Npc_sparkle" parent="." instance=ExtResource("r29_npc")]
position = Vector2(0, 548)
npc_id = &"sparkle"
display_name = "Sparkle"
sprite_frames = ExtResource("r30_sparkle_frames")
lines = PackedStringArray("The water's lovely! Well, it's freezing. But it's lovely once you stop screaming.", "Everyone says don't dive off the end of the pier. Everyone is very boring.", "Cousin Loki keeps sending guards to 'keep an eye on us'. We lost them on the first day. They're probably still looking under the boardwalk.", "Sassy and I come every summer. I do the diving, she does the sun loungers. It's a system.", "I swam out past the yachts in the dark last night. There's a little light out on the water some nights, low down, no ship I can see. Spooky. I loved it.", "You can see the sand on the bottom all the way out to the deck. Then it goes dark blue and you can't. That's where I go.")
wander_radius = 0.0

[node name="Npc_sassy" parent="." instance=ExtResource("r29_npc")]
position = Vector2(-460, -24)
npc_id = &"sassy"
display_name = "Sassy"
sprite_frames = ExtResource("r31_sassy_frames")
lines = PackedStringArray("Is it Tuesday? It feels like a Tuesday. Everything here feels like a Tuesday. I love it.", "Sparkle's off jumping off something again. She'll be fine. She's always fine. I'm going to have another drink with an umbrella in it.", "Our cousins are the royals, you know. Well, everybody knows. Well, I think everybody knows. Do you know?", "The waiter says Duke booked the whole top floor again. Duke is lovely. He always talks about mines. Gold mines? Card mines? I stop listening.", "I put sun cream on twice and then forgot which side. I'm going to be stripy.", "The man at the bar makes a drink that's blue. I don't know what's in it. I don't want to know. I want another one.")
wander_radius = 0.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(0, -124)
script = ExtResource("r32_readable")
title = "A brass plaque"
lines = PackedStringArray("'SEABRIGHT QUAY. Opened by Royal Charter for the rest and pleasure of the Crown's friends.'", "Smaller, underneath: 'Built through the generosity of the Duskara Mining Company.'")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-34, 512)
script = ExtResource("r32_readable")
title = "The pier sign"
lines = PackedStringArray("'NO DIVING FROM THE PIER.' Somebody has scratched a little crown under it, and the words 'except us'.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(600, 40)
script = ExtResource("r32_readable")
title = "A lookout on the headland"
lines = PackedStringArray("A brass telescope on a post, pointed east along the coast. Through it: open sea, and very far off, a barge with no lights, riding low.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(-470, -112)
script = ExtResource("r32_readable")
title = "The bar's chalkboard"
lines = PackedStringArray("'TODAY: the Seabright Blue. Ask for it by name. Do not ask what is in it.' Under it, smaller: 'Racers: cash only.'")

