lines = PackedStringArray("This bungalow is occupied. Move along.")
wander_radius = 0.0

[node name="Npc_waiter" parent="." instance=ExtResource("r36_npc")]
position = Vector2(-40, 404)
npc_id = &"waiter"
display_name = "Waiter"
sprite_frames = ExtResource("r41_waiter_frames")
lines = PackedStringArray("Table for one? Lovely. Mind the gentlemen in the suits; they don't like to be looked at. Or spoken to. Or walked past, really.", "The Duke tips in silver. Strange silver. Pepper won't take it in the till; she says it's still warm from somewhere.", "Miss Sparkle swam under the terrace this morning and came up through the kitchen hatch. Pepper screamed. The Duke applauded.", "Specials are on the board. The special is always the stew. Chef won't let it be anything else.")
wander_radius = 40.0

[node name="Npc_lifeguard" parent="." instance=ExtResource("r36_npc")]
position = Vector2(-560, 90)
npc_id = &"lifeguard"
display_name = "Lifeguard"
sprite_frames = ExtResource("r42_lifeguard_frames")
lines = PackedStringArray("Swim between the parasols, please! Not past the yachts. And not off the pier, Miss Sparkle, I can SEE you!", "Calm water, clear to the bottom, warm as a bath. Best beach on the island. Worst-behaved owner.", "There's a current past the last bungalow that pulls you east at night. Things wash up on the headland rocks: crates, rope, once a boot.", "I've pulled Miss Sparkle out of the water four times this week. She's thanked me once. She says that's a fair rate.")
wander_radius = 30.0

[node name="Npc_pepper" parent="." instance=ExtResource("r36_npc")]
position = Vector2(84, 372)
npc_id = &"pepper"
display_name = "Pepper"
sprite_frames = ExtResource("r43_pepper_frames")
lines = PackedStringArray("Welcome to the Saltglass Terrace! Everything on the menu is Chef's own. I just cook it. Exactly as written. Mostly.", "Chef trained me in Vetrassa for six years. He sent me here with a trunk of recipes and a list of things I'm never to do to a mussel.", "The stew's the one they come for. Saffron, the morning's catch, and Chef's stock, which arrives sealed by courier and I'm not allowed to know what's in it.", "The Duke dines here every night he's in. Same table, same tart, same three quiet gentlemen who never order anything.", "A letter came from the inn at Sorenda saying her stew is better than Chef's. I've framed it. Chef doesn't know. Please don't tell him.", "Mind the gulls. They've learned what a plate looks like.")
wander_radius = 0.0
shop_stock = Array[StringName]([&"seabright_stew", &"chefs_tart", &"bread"])
shop_buys_cards = false
shop_title = "The Saltglass Terrace"

[node name="Read0" type="Node2D" parent="."]
position = Vector2(0, -124)
script = ExtResource("r44_readable")
title = "A brass plaque"
lines = PackedStringArray("'SEABRIGHT QUAY. Opened by Royal Charter for the rest and pleasure of the Crown's friends. Given by His Majesty into the keeping of the Ladies Sparkle and Sassy.'", "Smaller, underneath: 'Built through the generosity of the Duskara Mining Company.'")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-60, 340)
script = ExtResource("r44_readable")
title = "The Saltglass menu"
lines = PackedStringArray("THE SALTGLASS TERRACE. 'The dishes of Chef, of Vetrassa, prepared by Pepper.'", "Seabright Stew: saffron, mussels, prawns, the morning's catch. Lemon Tart: Chef's own. Bread: from the oven, when the oven agrees.", "At the bottom, in a different hand: 'Private dining for the Company's guests by arrangement. Ask Fennick.'")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(-34, 540)
script = ExtResource("r44_readable")
title = "The pier sign"
lines = PackedStringArray("'NO DIVING FROM THE PIER.' Somebody has scratched a little crown under it, and the words 'except us'.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(-260, 384)
script = ExtResource("r44_readable")
title = "A bungalow door"
lines = PackedStringArray("A brass number plate: 'Bungalow 3. Do not disturb.' A tray of untouched breakfast outside. Someone inside is talking quietly about tonnage.")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(600, 40)
script = ExtResource("r44_readable")
title = "A lookout on the headland"
lines = PackedStringArray("A brass telescope on a post, pointed east along the coast. Through it: open sea, and very far off, a barge with no lights, riding low.")

[node name="Read5" type="Node2D" parent="."]
position = Vector2(-470, -112)
script = ExtResource("r44_readable")
title = "The bar's chalkboard"
lines = PackedStringArray("'TODAY: the Seabright Blue. Ask for it by name. Do not ask what is in it.' Under it, smaller: 'Racers: cash only.'")

