[node name="Npc_zahra" parent="." instance=ExtResource("r32_npc")]
position = Vector2(200, -60)
npc_id = &"zahra"
display_name = "Zahra"
sprite_frames = ExtResource("r33_zahra_frames")
lines = PackedStringArray("Water first, questions after. The Sunwell's the only sweet water between the plains and Duskara. Drink.", "I've guided caravans across Siroth for twenty years. The dunes move, the road moves, the Company's carts never stop.", "The carts go west full of food and come back east full of crates, under canvas, always at night. I don't ask what's in them. I've stopped asking.", "Mind the sand lions. They sleep in the heat and hunt at dusk, and they've learned the carts mean food.", "There's a temple up on the north mesa older than any king. Sun on every column. Go up at noon and the stones are warm as bread.", "My cousin Rafi sells water in Duskara. Tell him the bell still rings. He'll know what it means.")
wander_radius = 30.0

[node name="Read0" type="Node2D" parent="."]
position = Vector2(440, -710)
script = ExtResource("r34_readable")
title = "The Sun Temple altar"
lines = PackedStringArray("An altar on the mesa, ringed with broken columns, each one carved with a rising sun. On the altar's face, worn almost smooth: a crown, and under it a long line of small figures, each one smaller than the last, walking down into the ground.", "Someone has cut a new line into the stone, crisp and recent: a little figure walking back up.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-560, 650)
script = ExtResource("r34_readable")
title = "The serpent's skull"
lines = PackedStringArray("A skull the size of a cart, horned, its jaw sunk in the sand. Whatever this was, it was longer than the Kalmora quay.", "The sand around the bones is ridged in long curves, as though something heavy has been through it. Recently.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(620, 650)
script = ExtResource("r34_readable")
title = "The waystation board"
lines = PackedStringArray("A tally board nailed to a post: 'D.M.C. WAYSTATION. CARTS WATER HERE. HEADS COUNTED HERE.' Columns of marks, a total at the bottom of each.", "The 'out' column is longer than the 'in' column. Every week.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(-1060, 70)
script = ExtResource("r34_readable")
title = "The canyon signpost"
lines = PackedStringArray("'DUSKARA. Property of the Duskara Mining Company. Visitors welcome at the Cistern. Visitors do not go past the upper gate.'")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(880, 570)
script = ExtResource("r34_readable")
title = "A half-buried cart"
lines = PackedStringArray("An ore cart buried to its axles. Inside: a child's sandal, very small, and a brass tag on a string, stamped with a number and a red sun.")

