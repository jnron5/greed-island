[node name="Read1" type="Node2D" parent="."]
position = Vector2(-80, -300)
script = ExtResource("82_read")
title = "The longhouse post"
lines = PackedStringArray("A carved post by the longhouse door, covered in names. Beside each name, a notch.", "The oldest notches are wide and deep. The newest ones are small, low down, and there are a great many of them.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(560, -420)
script = ExtResource("82_read")
title = "A child's boot"
lines = PackedStringArray("A little leather boot, stiff with mud, caught in the moss by the gate. Too small to be a racer's.", "Small footprints lead from it to the cave mouth, and don't come back.")

