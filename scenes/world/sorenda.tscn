[node name="Npc_moss" parent="." instance=ExtResource("82_npc")]
position = Vector2(60, -290)
npc_id = &"moss"
display_name = "Elder Moss"
sprite_frames = ExtResource("82_moss")
lines = PackedStringArray("Sorenda sits where the old roads cross. Every race, the racers come through. Some are running to something. Some from it.", "The trees here remember everyone who passes. That's not a story, dear. Put your hand on the bark by the Hollow and you'll see.", "We carve a notch in the longhouse post for every one of ours who goes east for the Duskara work. We haven't had to carve a homecoming in years.")
wander_radius = 0.0
has_night_spot = true
night_spot = Vector2(0, 200)
night_wander = 10.0

[node name="Npc_harl" parent="." instance=ExtResource("82_npc")]
position = Vector2(-430, 60)
npc_id = &"harl"
display_name = "Harl"
sprite_frames = ExtResource("82_harl")
lines = PackedStringArray("Cut timber for the Duskara road three winters running. Good coin. Then they wanted timber for pens. Small pens. I came home.", "Hounds are bolder this year. Something out east has them spooked, or hungry. Keep your cards bound on the road.", "The Runner came through last week, fast as ever. Stopped at the Hollow, though. Stood there a long time. Didn't say why.")
wander_radius = 20.0
out_from = 6.0
out_to = 20.0

[node name="Npc_pell" parent="." instance=ExtResource("82_npc")]
position = Vector2(-350, 230)
npc_id = &"pell"
display_name = "Pell"
sprite_frames = ExtResource("82_pell")
lines = PackedStringArray("Mushrooms by the well are fine to eat. The glowing ones down in the Hollow aren't. Trust me.", "I found a little boot in the moss by the Hollow. Too small to be a racer's. Too far from any house to be one of ours.", "The Hollow gate wants a card to open. Elder Moss says it's to keep the forest's secrets. I think it's to keep us from finding them.")
wander_radius = 30.0
has_night_spot = true
night_spot = Vector2(100, 196)
night_wander = 16.0

[node name="Npc_wren" parent="." instance=ExtResource("82_npc")]
position = Vector2(-250, -260)
npc_id = &"wren"
display_name = "Wren"
sprite_frames = ExtResource("82_wren")
lines = PackedStringArray("I copy the village's stories out every winter, so they don't fade. Some of them I'd rather let fade.", "Seven children went east last spring. I wrote their names in the book. I write a lot of names in the book.")
wander_radius = 12.0
out_from = 8.0
out_to = 19.0

[node name="Npc_juniper" parent="." instance=ExtResource("82_npc")]
position = Vector2(500, -160)
npc_id = &"juniper"
display_name = "Juniper"
sprite_frames = ExtResource("82_juniper")
lines = PackedStringArray("Mind the drying rack. That's feverfew, and it doesn't like being walked through.", "Something in the Hollow has been clawing at the roots. The whole hill smells of bear.")
wander_radius = 12.0
has_night_spot = true
night_spot = Vector2(520, -330)
night_wander = 30.0

