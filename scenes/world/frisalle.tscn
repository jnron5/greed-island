[node name="Read0" type="Node2D" parent="."]
position = Vector2(-40, -16)
script = ExtResource("r40_readable")
title = "The weigh house tally board"
lines = PackedStringArray("Chalk on slate, columns ruled straight: date, cart, weight, sealed by. Bodo's square hand.", "Since the slide: 'nil, nil, nil' all down the 'over the pass' column. And then a second column, unheaded, that isn't nil at all. Forty carts this winter, heavy ones, all 'sealed by' the same little crossed-pick mark.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-250, -436)
script = ExtResource("r40_readable")
title = "The bell tower"
lines = PackedStringArray("A carved gold star on the spire, and a bronze bell green with age. Carved round the door: the names of every guide lost on the pass.", "The last name is fresh: Anselm, the year of the slide.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(60, 540)
script = ExtResource("r40_readable")
title = "The toll hut notice"
lines = PackedStringArray("'TRAVELLERS. Frisalle welcomes all who pay the toll at the pass. Wolves are not travellers. The Hearth & Horn serves supper at dusk.'")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(-300, 196)
script = ExtResource("r40_readable")
title = "The frozen pond"
lines = PackedStringArray("Skates hung on a peg by the bank. Scratched into the ice, in a child's careful hand: a crown, and a little figure under it, and another, and another.")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(70, 246)
script = ExtResource("r40_readable")
title = "The signpost"
lines = PackedStringArray("Three arrows. 'THE PASS' (south). 'THE HEARTH & HORN' (west, with a little painted horn). The third has been sawn off; the stump points north, at the mountain.")

