[node name="Read0" type="Node2D" parent="."]
position = Vector2(28.799999999999955, 275.20000000000005)
script = ExtResource("14_read")
title = "The tally gate"
lines = PackedStringArray("A turnstile of iron bars across the tunnel, a brass slot beside it for a tag, and a counter that clicks each time it turns. Painted over it: 'EVERY HEAD COUNTED. COUNT TRUE.'")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(-185.60000000000002, -12.799999999999955)
script = ExtResource("14_read")
title = "The sorting floor"
lines = PackedStringArray("Long tables, low enough for small arms. Trays of card-stone in teal and gold, sorted by size, by colour, by whether it will take a picture. Slates with tallies chalked on them. The chairs are crates.", "There's a song chalked under one table, a counting song. It counts down, not up.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(544, -217.60000000000002)
script = ExtResource("14_read")
title = "The King's Seam"
lines = PackedStringArray("The oldest working: a vein of card-stone running through the rock like a river of glass, teal and gold, lit from inside. The walls are scored with tool marks centuries deep.", "A plaque bolted to the rock: 'THE KING'S SEAM. Opened by the first king. Worked without interruption ever since.' Without interruption.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(-480.0, -249.60000000000002)
script = ExtResource("14_read")
title = "The bunks"
lines = PackedStringArray("Bunks in rows, too short for anyone grown. A tin cup on each. A rag doll on a pillow, its face sewn on twice.", "Scratched into the wood of the top bunk, in many hands: names. Then a line through each, and beside some of them, a little green sun.")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(12.799999999999955, -377.6)
script = ExtResource("14_read")
title = "The ledger of names"
lines = PackedStringArray("The foreman's own ledger, under a lamp in the lower office: names, ages, where from, the date down, the date up. Columns and columns. Most of the 'up' column is empty.", "'Corin, 14, Verdana. Sheepdog. Red scarf. Down: harvest, two years past. Up: --. Transferred: North Workings.' Further on, a page of numbers with no names at all.")

[node name="Read5" type="Node2D" parent="."]
position = Vector2(-400.0, 204.79999999999995)
script = ExtResource("14_read")
title = "The lake under the town"
lines = PackedStringArray("Black water, perfectly still, stretching away under the rock. Hesper was right: Duskara floats on a lake. A bucket on a rope hangs from the ceiling far above; the Cistern's well comes down here.")

[node name="Read6" type="Node2D" parent="."]
position = Vector2(-614.4, 403.20000000000005)
script = ExtResource("14_read")
title = "A crawl behind the old workings"
lines = PackedStringArray("A gap behind a fallen prop, just wide enough to crawl. The dust is swept. Someone has scratched a green sun on the timber, and an arrow: out.")

[node name="Npc_gideon" parent="." instance=ExtResource("17_npc")]
position = Vector2(-92.79999999999995, 422.4)
npc_id = &"gideon"
display_name = "Gideon"
sprite_frames = ExtResource("n_gideon")
lines = PackedStringArray("Halt there. ...Ah, you're not a runner. Nobody's checked who's coming down this shaft in years. I'm the night watch. I watch the dark.", "The tally gate counts you in. Show it a tag and it opens, and the book says one more head. The book's never wrong. The book's never right, either.", "Forty years I've watched this landing. I've seen them come down small and come up taller, and I've seen them not come up.", "If anyone asks, I was asleep. I'm old. I sleep a great deal. Especially when the right sort of visitor comes by.")

[node name="Npc_sorter_pup" parent="." instance=ExtResource("17_npc")]
position = Vector2(-80.0, -19.200000000000045)
npc_id = &"sorter_pup"
display_name = "Tag 212"
sprite_frames = ExtResource("n_sorter_pup")
lines = PackedStringArray("Can't talk. Count's at dawn. Teal ones in the left basket, gold in the right, cracked ones in the sack. Don't touch, they cut.", "My name? It's on the tag. Two-one-two. I had another one before. I'll remember it when I'm out.", "The foreman's fair. She says so. She counts us every night so nobody gets lost.")
sprite_offset_y = -22.0

[node name="Npc_sorter_kit" parent="." instance=ExtResource("17_npc")]
position = Vector2(102.39999999999998, -19.200000000000045)
npc_id = &"sorter_kit"
display_name = "Tag 167"
sprite_frames = ExtResource("n_sorter_kit")
lines = PackedStringArray("You're not from here. You've got sun on you. What's it like up there today?", "I sort the King's Seam stone. It's the best. It goes to the racers, Gideon says. Maybe one of yours came through my hands.", "Ada's sick. She's in the bunks. Nobody's allowed to say she's sick or they'll move her to the infirmary, and nobody comes back from the infirmary.")
sprite_offset_y = -22.0

[node name="Npc_sorter_pup2" parent="." instance=ExtResource("17_npc")]
position = Vector2(-44.799999999999955, 102.39999999999998)
npc_id = &"sorter_pup"
display_name = "Tag 98"
sprite_frames = ExtResource("n_sorter_pup")
lines = PackedStringArray("Shh. The overseer's looking.", "There's a light out in the dunes some nights. Green. Gideon says it's marsh-fire. There's no marsh in the dunes.")
sprite_offset_y = -22.0

[node name="Npc_company_man" parent="." instance=ExtResource("17_npc")]
position = Vector2(448, -96)
npc_id = &"company_man"
display_name = "Overseer"
sprite_frames = ExtResource("n_company_man")
lines = PackedStringArray("Visitor? No visitors in the Seam. Back up to the sorting floor.")

[node name="Npc_ada" parent="." instance=ExtResource("17_npc")]
position = Vector2(-499.2, -172.8)
npc_id = &"ada"
display_name = "Ada"
sprite_frames = ExtResource("n_ada")
lines = PackedStringArray("...Is it morning? It always feels like morning down here. Or it never does.")
sprite_offset_y = -22.0

