title = "A ship in a bottle"
lines = PackedStringArray("The Gull's Mercy, rigged in thread. A note is tied round the cork:", "'For my old crew. We carried what we were told and never opened the hold. May the sea forgive the rest.'")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(222, 164)
script = ExtResource("12_read")
title = "Fenn's logbook"
lines = PackedStringArray("'Fourth run south to the Duskara landing this season. Out: boots, forty pairs, small. Back: sealed crates, heavy, singing a little when the sea was calm.'", "'Asked the foreman about the singing. Was told it was the wind in the slats.'")

