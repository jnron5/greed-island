[node name="Read1" type="Node2D" parent="."]
position = Vector2(80, 124)
script = ExtResource("12_read")
title = "A deed on the vanity"
lines = PackedStringArray("Heavy paper, a royal seal. 'Seabright Quay, its quay, terrace, bungalows and the Grand, to my nieces Sparkle and Sassy, to keep and to enjoy. L.'", "Pinned behind it, a smaller note: 'Upkeep, staff and stores met in full by the Duskara Mining Company, in gratitude for the Crown's friendship.' No signature. A stamp of a pick and a crown.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(266, 178)
script = ExtResource("12_read")
title = "Sparkle's dive log"
lines = PackedStringArray("Scrawled in waterproof pencil. 'Night dive. The light again, low on the water past the yachts. A barge, no lamps. Third night running.'", "'They let something down on a rope at the old reef and pull it up empty. Tomorrow I swim out and see what's on the rope. DON'T tell Sassy. Sassy, if you're reading this, stop it.'")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(160, 160)
script = ExtResource("12_read")
title = "Sassy's seating plan"
lines = PackedStringArray("A card covered in hearts and crossings-out. 'Dinner, Saturday. Duke on my right (he likes that). His three gentlemen next to him; they said not to write names, just put 'Company'.'", "'Cousin Chef: said he'd come, didn't. Cousin Freya: sent two guards instead. Cousin Sully: never answers. Note to self: ask Uncle why nobody comes to our parties.'")

[node name="Read4" type="Node2D" parent="."]
position = Vector2(88, 168)
script = ExtResource("12_read")
title = "A letter on the trunk"
lines = PackedStringArray("'Sparkle, Sassy. Pepper is under-salting the stew. Tell her. Do not tell her I said tell her. Duke says the business guests liked the tart. Good. Burn this. C.'", "It has not been burned. Somebody has drawn a moustache on the signature.")

