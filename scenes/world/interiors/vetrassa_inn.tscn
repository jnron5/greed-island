[node name="Npc_brigid" parent="." instance=ExtResource("9_npc")]
position = Vector2(210, 152)
npc_id = &"brigid"
display_name = "Brigid"
sprite_frames = ExtResource("n_brigid")
lines = PackedStringArray("In you come, out of the wind! Vetrassa's wind comes straight off the sea and goes straight through you. Sit by the fire.", "Every racer ends up at the Crown & Anchor. The winners for one night, the losers for a week.", "The palace? Up the grand stairs. The Steward checks every card. He once sent a racer away for a bent corner.", "Freya drinks here when she's off the steps. Quiet as stone. She's waiting for something, that one, and it isn't a racer.", "The Duke's men drink here too, on the Company's tab. I charge them double and the Company pays it without blinking. Makes you wonder how rich the ground is.", "My rooms are warm and my beds are long. Half a day or a whole one, and you'll walk up those stairs mended.")
inn_rooms = true
shop_stock = Array[StringName]([&"bread", &"smoked_fish", &"healers_tonic"])
shop_buys_cards = false
shop_title = "The Crown & Anchor"
wake_lines = PackedStringArray("Easy, easy. The guard carried you in off the square. The whole town saw. Don't worry, they've seen worse.", "There you are. You were out cold on the quay. I put you by the fire and told everyone you were resting your eyes.")
room_prompt = "A long bed and a warm stone. Half a day, or the whole day?"
room_broke = "It's %d gold, love. Sit by the fire as long as you like, though; that's free."

[node name="Read1" type="Node2D" parent="."]
position = Vector2(212, 106)
script = ExtResource("12_read")
title = "The racers' wall"
lines = PackedStringArray("Over the bar, names scratched into the stone: racers of past years. Next to some, a little crown. Every crowned name is a different hand. None of them is a name anyone in town remembers.")

