[node name="Npc_bodo" parent="." instance=ExtResource("9_npc")]
position = Vector2(160, 160)
npc_id = &"bodo"
display_name = "Bodo"
sprite_frames = ExtResource("n_bodo")
lines = PackedStringArray("This is a private house! I mean. Welcome. Wipe your feet. Don't touch the cups.", "Lovely chair, isn't it? Walnut. Carved locally. I paid a fair price. A very fair price.")
out_from = 21.0
out_to = 6.0

[node name="Read1" type="Node2D" parent="."]
position = Vector2(124, 124)
script = ExtResource("12_read")
title = "A letter in the desk drawer"
lines = PackedStringArray("The drawer isn't locked. It's the false bottom of the box inside it that's locked, and Bodo has left the key in it.", "'B. Forty loads this winter, through the ice road. Weigh them, seal them, forget them. Your fee is enclosed. The Company thanks you. D.' The seal on it is a dachshund's head over a crossed pick.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(182, 120)
script = ExtResource("12_read")
title = "A cabinet of silver cups"
lines = PackedStringArray("Racing cups, christening cups, a punch bowl. None of them engraved with Bodo's name. All of them new.")

