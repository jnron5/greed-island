[node name="Npc_steward" parent="." instance=ExtResource("9_npc")]
position = Vector2(208, 126)
npc_id = &"steward"
display_name = "The Steward of the Set"
sprite_frames = ExtResource("n_steward")
lines = PackedStringArray("Welcome to the throne room. You have the look of a racer: tired, and certain.", "I keep the set. Every race, someone brings it up those steps, and every race I check it card by card. It is the only part of my work I enjoy.", "The throne has been empty for some time. His Majesty travels. He always has, in a race year.", "What is owed to the winner? Everything that was promised, and nothing that wasn't. I'm afraid that's all I'm permitted to say.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(159, 116)
script = ExtResource("12_read")
title = "The empty throne"
lines = PackedStringArray("A high gold throne on a raised step, its blue cushion worn into the shape of whoever sat in it last. There's dust on the arms. Nobody has sat here in a long while.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(189, 118)
script = ExtResource("12_read")
title = "The Throne Ledger"
lines = PackedStringArray("A great book on the lectern by the throne, chained to it. The King's own record: every race, every winner, every king. The first page is in a hand older than the island's roads.", "'The set is gathered from the land, and the land gives what is taken from it.' Then, every race since: 'Seam worked. Count true.' The last entry is in a familiar hand, signed L.")

