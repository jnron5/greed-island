[node name="Read1" type="Node2D" parent="."]
position = Vector2(100, 108)
script = ExtResource("12_read")
title = "The tunnel chart"
lines = PackedStringArray("A chart of the workings under Duskara: the North Shaft, then tunnels branching east under the dunes, further than seems possible, each one marked with a date and a number of heads.", "The oldest tunnel is labelled in a different, older hand: 'THE KING'S SEAM.' Someone has written beside it, in the foreman's: 'Still producing.'")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(184, 108)
script = ExtResource("12_read")
title = "The tag board"
lines = PackedStringArray("Rows of brass tags on hooks, each stamped with a number and a red sun, like the one on the frost wolves' collars. Hundreds of them.", "Some hooks are empty, with a chalk cross under them. Some crosses have been rubbed out and redrawn as a circle. Nobody has written what a circle means.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(166, 184)
script = ExtResource("12_read")
title = "The foreman's desk"
lines = PackedStringArray("A day ledger, open: 'Down 212. Up 209. Three in the infirmary. Count true.' Signed with an X in black ink, firm.", "Under the ledger, a letter on heavy paper: 'Production must rise before the race is run. Your husband's indulgence of the old custom cannot be allowed to cost us the season. D.' The seal is a dachshund's head over a crossed pick.")

