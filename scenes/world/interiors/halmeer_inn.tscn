[node name="Npc_maudie" parent="." instance=ExtResource("9_npc")]
position = Vector2(196, 150)
npc_id = &"maudie"
display_name = "Maudie"
sprite_frames = ExtResource("n_maudie")
lines = PackedStringArray("Come in, shut the door, the wind's got teeth tonight. It's always got teeth. Welcome to the Gull's Rest.", "Fish stew, fish pie, or bread with fish in it. We had a cook once who tried soup without fish. We don't talk about him.", "My Tom went out on one of the dark nights, three winters back. Said the Company paid double for a hand on the barge. The barge came back. He didn't.", "Nessa on the cape keeps the light. Mostly. You can tell the dark nights: the whole village goes to bed early and pulls the shutters.", "Racers! We get one a year, maybe. Most of you come for the cape chest and leave before supper. Stay for supper.", "The Company man, Grisel, eats in that corner every night with his ledger. Doesn't drink. Doesn't talk. Tips well. I don't trust any of it.", "My rooms look out over the harbour. Half a day or the whole day; you'll sleep, the sea'll see to that.")
inn_rooms = true
shop_stock = Array[StringName]([&"bread", &"smoked_fish", &"healers_tonic"])
shop_buys_cards = false
shop_title = "The Gull's Rest"
wake_lines = PackedStringArray("There you are. Ferro carried you up off the quay like a wet net. You're in the Gull's Rest. Lie still.", "You gave us a turn. Out cold on the cliff road. Drink this, it's mostly fish.")
room_prompt = "A bed by the window and the sea to sing you down. Half a day, or the whole day?"
room_broke = "That's %d gold, love. Sit by the fire as long as you like, mind; the fire's free."

[node name="Read1" type="Node2D" parent="."]
position = Vector2(196, 104)
script = ExtResource("12_read")
title = "The chalkboard behind the bar"
lines = PackedStringArray("Today's catch, in chalk. Below it, a list of names with ticks: who owes for drink. And at the bottom, smaller: 'Dark night Thursday. Shutters.'")

