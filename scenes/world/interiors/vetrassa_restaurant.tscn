[node name="Npc_chef" parent="." instance=ExtResource("9_npc")]
position = Vector2(204, 130)
npc_id = &"chef"
display_name = "Chef"
sprite_frames = ExtResource("n_chef")
lines = PackedStringArray("Welcome to Chef's. Yes, that's the name. When you're the best, you don't need another one.", "My stew? Pepper at Seabright makes it with my recipe and my saffron and somehow it's still not mine. A recipe is a map. Cooking is the walking.", "The Duke dines here every night he's in Vetrassa. Him and his 'Company' friends, in the alcove, behind the curtain. They tip extravagantly. I hear everything.", "My father taught me to cook. Then he taught me to keep secrets. I'm much better at the first one.", "Tally in Verdana keeps sending me letters about gravy. I wrote back once, to be polite. I said her gravy was honest. I meant it.", "My little brother hasn't come home in years. My mother says he's ungrateful. I say he's the only one of us who walked out of the kitchen when it got too hot.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(106, 134)
script = ExtResource("12_read")
title = "The private alcove"
lines = PackedStringArray("A table for three behind a velvet curtain, laid with the best silver. A card on the cloth: 'Reserved. The Duke and guests. To the Company's account.'", "Under the table, a napkin with figures pencilled on it: tonnages, and a route through 'the shoulder', and a name crossed out: Halmeer.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(210, 244)
script = ExtResource("12_read")
title = "Tonight's menu"
lines = PackedStringArray("'CHEF'S. Saffron stew of the north. Lemon tart. Roast of the King's own herd.' At the bottom, in Chef's hand: 'No substitutions. No exceptions. No Company tabs after the race.'")

