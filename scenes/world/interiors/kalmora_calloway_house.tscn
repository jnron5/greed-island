[node name="Npc_calloway" parent="." instance=ExtResource("9_npc")]
position = Vector2(190, 140)
npc_id = &"calloway"
display_name = "Lady Calloway"
sprite_frames = ExtResource("n_calloway")
lines = PackedStringArray("Another racer. Do wipe your feet. My grandson is racing too, you know. Calloways always race.", "The Duskara trade built this island, dear. Everyone eats from that table. Some of us simply set it.", "The King's race is older than any of us. Old things have their reasons. I wouldn't go digging for them.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(160, 118)
script = ExtResource("12_read")
title = "The family portrait"
lines = PackedStringArray("Four generations of Calloways, painted in gold leaf. Behind them, very small, a window shows red dunes.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(104, 158)
script = ExtResource("12_read")
title = "A letter on the desk"
lines = PackedStringArray("'Mother. The Duskara consignment is short again; the foreman blames the heat. Tell him the King's count must be met. Hire younger if he must. - H.'")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(86, 190)
script = ExtResource("12_read")
title = "An iron strongbox"
lines = PackedStringArray("Locked tight. A brass plate on the lid: 'CALLOWAY & DUNE, SHIPPING. Est. the year of the Third Race.'")

