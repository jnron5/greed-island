[node name="Npc_oren" parent="." instance=ExtResource("9_npc")]
position = Vector2(180, 150)
npc_id = &"oren"
display_name = "Oren"
sprite_frames = ExtResource("n_oren")
lines = PackedStringArray("Mind the furnace. It's been lit for nine years. If it goes out, so do I.", "Duskara sand makes the clearest glass on the island. The Company wants it for lamps. Lamps for the shaft. I make them. I don't like making them.", "Every bottle on that shelf has a little air trapped in it from the day I blew it. My breath, nine years of it. Sentimental, for a dog who works with fire.", "The old temple on the mesa has sun-glass in its sand, where lightning struck it. Green as a lizard's eye. I'd go up and gather it, if I could leave the furnace.", "Nib comes in to warm his hands in the cold nights. Don't let the heat fool you; the desert freezes after dark. He sits by the furnace and says nothing at all.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(254, 188)
script = ExtResource("12_read")
title = "A cooling rack of glass"
lines = PackedStringArray("Lamps, dozens of them, with heavy bases and wire cages: miner's lamps. Each base is stamped D.M.C. One, at the end, has a tiny sun scratched inside its glass where nobody would see it.")

