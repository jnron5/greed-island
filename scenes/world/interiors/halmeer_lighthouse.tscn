[node name="Npc_nessa" parent="." instance=ExtResource("9_npc")]
position = Vector2(140, 160)
npc_id = &"nessa"
display_name = "Nessa"
sprite_frames = ExtResource("n_nessa")
lines = PackedStringArray("Mind the stair, it's older than me and less forgiving. Forty years I've kept this light.", "A light's a promise. Whoever's out there, whatever they're carrying, you tell them where the rocks are. That's the whole job.", "My knees won't do the cut down to the sea cave any more. My ears still work. I hear oars under the cape on the dark nights.", "The Company pays well. That's the trouble with them. They always pay well.")

[node name="Read1" type="Node2D" parent="."]
position = Vector2(108, 118)
script = ExtResource("12_read")
title = "The keeper's log"
lines = PackedStringArray("Forty years of weather in a neat hand. 'Wind SW, light lit, all well.' Then, three winters back, every few weeks: 'Light dark. By order.' And once, underlined: 'Oars. Many.'")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(222, 112)
script = ExtResource("12_read")
title = "The tide chart"
lines = PackedStringArray("A chart of the cape's waters pinned to the wall. Someone has drawn a dotted line from the sea cave under the cape, round the reef, and off the edge of the chart, south. No harbour is marked at the end of it.")

