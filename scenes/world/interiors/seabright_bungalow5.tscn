[node name="Read1" type="Node2D" parent="."]
position = Vector2(230, 186)
script = ExtResource("12_read")
title = "A report, half-written"
lines = PackedStringArray("'Captain. Day nine. The Ladies are well. They know we are here and have taken to waving. Lady Sparkle swam under our bungalow at dawn and knocked on the floor.'", "'Nothing to report but this: the Duke's men do not sleep, and a boat with no lamps comes to the reef twice a week. Your mother's friends, I think. Shall I keep watching, or stop? F., I await your orders.'")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(122, 170)
script = ExtResource("12_read")
title = "A guard's tabard, folded"
lines = PackedStringArray("The black and gold of the King's Guard in Vetrassa, folded small and hidden under a beach towel. Whoever is staying here is not on holiday.")

