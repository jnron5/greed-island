[node name="Npc_hesper" parent="." instance=ExtResource("9_npc")]
position = Vector2(236, 192)
npc_id = &"hesper"
display_name = "Hesper"
sprite_frames = ExtResource("n_hesper")
lines = PackedStringArray("Come out of the sun. Sit. The Cistern stays cool all day; the old well under the floor breathes for us.", "Water's free in my house. It always was in Duskara, before the meters. I'm old-fashioned.", "Racers, Company clerks, caravan folk, the odd lost poet. Everyone ends up at the Cistern. There's nowhere else.", "The foreman eats here on the first of the month. Alone, at that table, with her ledger. Nobody sits near her. I always bring her an extra cup.", "Listen at the well some nights and you'll hear water moving far below. My grandmother said the whole town floats on a lake underground. The Company says that's their lake now.", "Rafi brings me sweet water from the Sunwell. I don't ask how he gets it past the Company tank, and he doesn't ask what I do with the extra beds.", "Sleep in the heat of the day, walk in the cool of the night. That's how Duskara has always lived. The shaft doesn't care what hour it is.", "My rooms are up the stair, under the dome. Cool as a cellar. Lie still and you can hear the town breathing.")
inn_rooms = true
shop_stock = Array[StringName]([&"bread", &"smoked_fish", &"healers_tonic"])
shop_buys_cards = false
shop_title = "The Cistern"
wake_lines = PackedStringArray("Shh, easy. Zahra's people found you face down in the dunes. You're in the Cistern. Drink first, then talk.", "You're awake. Good. The sand nearly had you. Lie still a while; the dome keeps the heat off.", "Welcome back to the living. Nib ran all the way to fetch me. Thank him, he won't ask you to.")
room_prompt = "A cool bed under the dome. Half a day, or sleep through the heat to tomorrow?"
room_broke = "That's %d gold, friend. Sit by the well a while instead; that's free, and so is the water."

[node name="Read1" type="Node2D" parent="."]
position = Vector2(160, 182)
script = ExtResource("12_read")
title = "The old cistern"
lines = PackedStringArray("A round stone well in the middle of the floor, its rim worn smooth by four hundred years of ropes. The water far down is black and cold.", "Scratched inside the rim, just below where a hand would rest: little marks in rows, like a tally. And beside them, a sun.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(210, 146)
script = ExtResource("12_read")
title = "The guest ledger"
lines = PackedStringArray("Names, dates, rooms. Racers. A caravan. Then, every few nights, the same entry in Hesper's neat hand: 'Two guests. No names. Paid.'")

