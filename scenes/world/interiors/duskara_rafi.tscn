[node name="Npc_rafi" parent="." instance=ExtResource("9_npc")]
position = Vector2(150, 170)
npc_id = &"rafi"
display_name = "Rafi"
sprite_frames = ExtResource("n_rafi")
lines = PackedStringArray("Ah! A visitor. Sit, sit. Tea? It's mostly sand, but it's hot.", "Two bedrolls? My cousin visits. Often. She has a lot of cousins.", "If anyone from the terrace asks, I sell water and I go to bed early. Both true. Mostly true.")
out_from = 21.0
out_to = 6.0

[node name="Read1" type="Node2D" parent="."]
position = Vector2(112, 112)
script = ExtResource("12_read")
title = "The roof hatch"
lines = PackedStringArray("A rope ladder up to a hatch in the roof. On the ledge beside it: a lamp with a green-tinted glass, the wick trimmed, a box of matches. From the roof, a green light would be seen a long way across the dunes.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(250, 150)
script = ExtResource("12_read")
title = "Bedrolls behind the jars"
lines = PackedStringArray("Behind the big water jars, rolled tight and tied: four small bedrolls, each about the length of a child. Clean, and recently used.")

