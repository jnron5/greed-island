[node name="Read1" type="Node2D" parent="."]
position = Vector2(218, 158)
script = ExtResource("12_read")
title = "The barge's log"
lines = PackedStringArray("A logbook on the chart table, damp at the edges. 'Loaded at the Halmeer landing: uncut, D.M.C., 40 crates. Out on the dark tide, round the reef, to the mainland ship.'", "Earlier pages trace the same crates back: 'Received from Vetrassa factors. Received at Frisalle by the ice road. Received from the North Shaft.' The whole island, crate by crate, out of this cave.")

[node name="Read2" type="Node2D" parent="."]
position = Vector2(124, 160)
script = ExtResource("12_read")
title = "D.M.C. crates"
lines = PackedStringArray("Crates stamped like the ones on every quay of the island. Prised open: uncut cards in straw, thousands of them. A tally tag is caught in the straw of one. Small.")

[node name="Read3" type="Node2D" parent="."]
position = Vector2(222, 112)
script = ExtResource("12_read")
title = "The landing stage"
lines = PackedStringArray("Planks laid out over the black water to the barge. A rope cleat with a cut rope end still tied to it, in a knot nobody in Halmeer will admit to knowing.")

