[resource]
script = ExtResource("1_card")
id = &"keepers_lamp"
display_name = "The Keeper's Lamp"
description = "Passive: while worn, savage beasts at night see you no sooner than by day, and hit you no harder."
lore = "Nessa's spare lamp from the Halmeer light, the one she kept lit in her window on the nights the Company paid her to keep the tower dark. Ships still found the harbour by it. So did she."
