display_name = "The Green Lamp"
description = "Passive: while worn, rivals notice you half as fast, and your steals are surer."
lore = "The escape line's light: a lamp with green glass on a Duskara rooftop, answered by another out in the dunes. Rafi gives one to each friend of the line. There aren't many."
